{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portal-kit:contracts:approval-grant:v1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "title": "Portal Kit approval grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "requirement_id", "workspace_id", "action", "target", "reviewer_subject_id", "status", "issued_at", "expires_at"],
  "properties": {
    "schema_version": { "const": "portal-kit.approval-grant.v1" },
    "grant_id": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/identifier" },
    "requirement_id": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/identifier" },
    "workspace_id": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/identifier" },
    "action": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/action" },
    "target": {
      "allOf": [
        { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/target" },
        { "type": "object", "required": ["revision"], "properties": { "revision": {} } }
      ]
    },
    "reviewer_subject_id": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/identifier" },
    "status": { "enum": ["active", "revoked"] },
    "issued_at": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/timestamp" },
    "expires_at": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/timestamp" }
  }
}
