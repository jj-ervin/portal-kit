{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portal-kit:contracts:audit-event:v1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "title": "Portal Kit redacted audit event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "request_id", "actor_subject_id", "workspace_id", "action", "target", "outcome", "reason_code", "occurred_at"],
  "properties": {
    "schema_version": { "const": "portal-kit.audit-event.v1" },
    "event_id": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/identifier" },
    "request_id": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/identifier" },
    "actor_subject_id": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/identifier" },
    "workspace_id": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/identifier" },
    "action": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/action" },
    "target": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/target" },
    "outcome": { "enum": ["allow", "deny"] },
    "reason_code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "occurred_at": { "$ref": "urn:portal-kit:contracts:shared:v1#/$defs/timestamp" }
  }
}
