{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:portal-kit:contracts:shared:v1",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "title": "Portal Kit shared contract definitions v1",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "action": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._:-][a-z0-9]+)+$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_id"],
      "properties": {
        "resource_type": { "$ref": "#/$defs/identifier" },
        "resource_id": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
